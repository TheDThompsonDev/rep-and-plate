# Line endings: every text file is stored with LF and checked out with LF on
# every platform, regardless of core.autocrlf. This replaces the per-machine
# autocrlf guess that produced "LF will be replaced by CRLF" warnings on
# 52 tracked files. Existing files are NOT rewritten by adding this file; see
# docs/audits/2026-10-10-repo-audit/notes/A6-hygiene.md for the one-time
# `git add --renormalize .` follow-up.
* text=auto eol=lf

# Windows-only scripts need CRLF to run.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets: never normalize, never show text diffs.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
*.gz binary
*.pdf binary
*.mp3 binary
*.mp4 binary
*.webm binary
*.sqlite binary
*.sqlite3 binary
*.db binary
