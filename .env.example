# Qwen handles chat, receipt/label reading, meal/workout planning and price research.
# When configured, Qwen is primary. Recoverable failures get one OpenAI backup attempt.
QWEN_API_KEY=
QWEN_MODEL=qwen3.5-flash
QWEN_BASE_URL=https://maas.qwencloudapi.com/compatible-mode/v1
# Backup is bounded by the original request deadline; set false to disable.
AI_FALLBACK_ENABLED=true
AI_FALLBACK_MODEL=gpt-5-mini
# OpenAI is used for fallback, voice transcription, and legacy setups without Qwen.
OPENAI_API_KEY=
JEV_API_KEY=
FOODDATA_GOV_API=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
OPENAI_MODEL=gpt-5-mini
JEV_MODEL=jev-latest

# Optional local database setup only. Use Connect > Session pooler on IPv4 networks.
SUPABASE_DB_URL=

# Hosted API only. Never expose these through VITE_* or EXPO_PUBLIC_*.
SUPABASE_SECRET_KEY=
APP_ORIGIN=

# Private preview: Vercel is locked by default, even when the code is missing.
# Use a randomly generated code of at least 20 characters; never use VITE_*.
PREVIEW_ACCESS_CODE=
# Optional: "on" to test the gate locally; "off" explicitly opens the site.
PRIVATE_PREVIEW=
